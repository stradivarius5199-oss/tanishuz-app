    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@sparks-uz/db": "workspace:*",
    "@sparks-uz/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.3.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.27.0",
    "socket.io": "^4.8.3",
